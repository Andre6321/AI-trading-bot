// =============================================================================
// BTC V9 Maximum Edge — SHORT-ONLY STRATEGY
// =============================================================================
//
// Pine Script STRATEGY based on V9 Maximum Edge experiment results.
// Use on BTCUSDT Perpetual, 1H timeframe.
//
// Two winning strategy profiles emerged from 99,840 backtested configs
// across 6 years (2020-01 → 2026-02), covering bull + bear cycles:
//
// STRATEGY A — "Precision Sniper" (RECOMMENDED for prop firms):
//   v9_noboost_momfilt | SHORT-only | momentum filter + hour filter
//   PF=1.54, WR=44.7%, Sharpe=3.94, MaxDD=0.8%, +$2,187 on $25K
//   438 trades / 6 years ≈ 73/yr ≈ 1.4/week
//   Key: Kelly+VolScale sizing, trail 0.75 ATR, skip 06-10 UTC
//
// STRATEGY B — "Volume Trader" (higher returns, more risk):
//   v9_fboost120_momfilt | SHORT-only | funding boost + momentum filter
//   PF=1.50, WR=44.5%, Sharpe=3.84, MaxDD=3.5%, +$12,165 on $25K
//   1,646 trades / 6 years ≈ 274/yr ≈ 5.3/week
//
// CRITICAL FINDING: The model is SHORT-biased. All top strategies are
// SHORT-only across all experiments. Longs consistently hurt performance.
//
// =============================================================================

//@version=6
strategy("BTC V9 Short-Only Strategy", overlay=true,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=25,
     initial_capital=25000,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     slippage=1,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=false,
     max_bars_back=500)

// ─── INPUTS ─────────────────────────────────────────────────────────────────
grp_mode = "Strategy Profile"
use_precision = input.bool(true, "Precision Mode (lower DD)", group=grp_mode,
     tooltip="ON = Strategy A (PF 1.54, DD 0.8%)\nOFF = Strategy B (PF 1.50, DD 3.5%, more trades)")

grp_entry = "Entry Settings"
sl_mult    = input.float(1.5, "Stop Loss (× ATR)", step=0.1, group=grp_entry)
tp_mult    = input.float(3.0, "Take Profit (× ATR)", step=0.5, group=grp_entry)
trail_mult = input.float(0.75, "Trailing Stop (× ATR)", step=0.05, group=grp_entry)
max_hold   = input.int(12, "Max Hold Bars", minval=1, group=grp_entry)
atr_len    = input.int(14, "ATR Length", group=grp_entry)

grp_filter = "Signal Filters"
min_atr_pct     = input.float(0.4, "Min ATR% (regime filter)", step=0.05, group=grp_filter)
hurst_len       = input.int(100, "Hurst Lookback", minval=50, group=grp_filter)
auto_len        = input.int(48, "Autocorrelation Lookback", minval=10, group=grp_filter)
ent_len         = input.int(48, "Entropy Lookback", minval=20, group=grp_filter)
rsi_len         = input.int(14, "RSI Length", group=grp_filter)
score_thr       = input.float(0.55, "Short Score Threshold", step=0.05, minval=0, maxval=1, group=grp_filter)

grp_time = "Time Filter"
skip_low_liq = input.bool(true, "Skip 06:00-10:00 UTC", group=grp_time,
     tooltip="Precision mode skips low-liquidity Asian hours. V9 results show this improves PF.")

grp_mom = "Momentum Filter"
use_mom_filter = input.bool(true, "Use Momentum Acceleration Filter", group=grp_mom,
     tooltip="Filters out trades when momentum is accelerating against the position.\nReduced trades by 34% but improved PF from 1.36 to 1.54.")
mom_accel_len  = input.int(12, "Momentum Acceleration Lookback", minval=4, group=grp_mom)

grp_sizing = "Position Sizing"
use_vol_scale = input.bool(true, "Volatility-Scaled Sizing", group=grp_sizing,
     tooltip="Scale position size inversely with ATR. Lower size in high-vol, higher in low-vol.")
vol_scale_target = input.float(1.0, "Target ATR% for Full Size", step=0.1, group=grp_sizing)

// ─── CORE CALCULATIONS ─────────────────────────────────────────────────────

log_ret = math.log(close / close[1])
atr_val = ta.atr(atr_len)
atr_pct = atr_val / close * 100
rsi_val = ta.rsi(close, rsi_len)

// ─── 1. HURST EXPONENT ─────────────────────────────────────────────────────
hurst_calc() =>
    float sum_log_tau = 0.0
    float sum_log_lag = 0.0
    float sum_cross = 0.0
    float sum_log_lag_sq = 0.0
    int count = 0
    for lag = 2 to 20
        float tau = 0.0
        for j = 0 to hurst_len - lag - 1
            diff = close[j] - close[j + lag]
            tau += diff * diff
        tau := math.sqrt(tau / math.max(hurst_len - lag, 1))
        if tau > 0
            float lt = math.log(tau)
            float ll = math.log(lag)
            sum_log_tau += lt
            sum_log_lag += ll
            sum_cross += lt * ll
            sum_log_lag_sq += ll * ll
            count += 1
    if count > 1
        float denom = count * sum_log_lag_sq - sum_log_lag * sum_log_lag
        denom != 0 ? (count * sum_cross - sum_log_lag * sum_log_tau) / denom : 0.5
    else
        0.5

hurst = hurst_calc()

// ─── 2. AUTOCORRELATION ────────────────────────────────────────────────────
autocorr(int lookback, int lag) =>
    float sx = 0.0, float sy = 0.0, float sxy = 0.0
    float sx2 = 0.0, float sy2 = 0.0
    int n = lookback - lag
    for i = 0 to n - 1
        float x = nz(log_ret[i + lag])
        float y = nz(log_ret[i])
        sx += x
        sy += y
        sxy += x * y
        sx2 += x * x
        sy2 += y * y
    float denom = math.sqrt((n * sx2 - sx * sx) * (n * sy2 - sy * sy))
    denom != 0 ? (n * sxy - sx * sy) / denom : 0.0

autocorr1 = autocorr(auto_len, 1)
autocorr5 = autocorr(auto_len, 5)

// ─── 3. RETURN ENTROPY ─────────────────────────────────────────────────────
entropy_calc() =>
    float min_r = 1e10
    float max_r = -1e10
    for i = 0 to ent_len - 1
        float r = nz(log_ret[i])
        min_r := math.min(min_r, r)
        max_r := math.max(max_r, r)
    float bw = (max_r - min_r + 1e-10) / 10.0
    array<float> bins = array.new_float(10, 0.0)
    float total = 0.0
    for i = 0 to ent_len - 1
        float r = nz(log_ret[i])
        int bi = math.min(int((r - min_r) / bw), 9)
        array.set(bins, bi, array.get(bins, bi) + 1.0)
        total += 1.0
    float ent = 0.0
    for b = 0 to 9
        float p = array.get(bins, b) / total
        if p > 0
            ent -= p * math.log(p)
    ent / math.log(10)

entropy = entropy_calc()

// ─── 4. GARMAN-KLASS VOLATILITY ────────────────────────────────────────────
gk_bar = 0.5 * math.pow(math.log(high / low), 2) - (2 * math.log(2) - 1) * math.pow(math.log(close / open), 2)
gk_vol = math.sqrt(math.max(ta.sma(gk_bar, 24), 0))

// ─── 5. MULTI-HORIZON MOMENTUM ─────────────────────────────────────────────
mom_1h   = log_ret
mom_4h   = math.log(close / close[4])
mom_12h  = math.log(close / close[12])
mom_24h  = math.log(close / close[24])
mom_72h  = math.log(close / close[72])
mom_168h = math.log(close / close[168])

// Bearish alignment for SHORT: what fraction of timeframes point down
bear_count = (mom_1h < 0 ? 1.0 : 0.0) + (mom_4h < 0 ? 1.0 : 0.0) +
             (mom_12h < 0 ? 1.0 : 0.0) + (mom_24h < 0 ? 1.0 : 0.0) +
             (mom_72h < 0 ? 1.0 : 0.0) + (mom_168h < 0 ? 1.0 : 0.0)
mom_alignment_short = bear_count / 6.0  // 1.0 = all bearish

// ─── 6. VOLUME PRESSURE ────────────────────────────────────────────────────
obv = ta.obv
obv_ma = ta.sma(obv, 20)
obv_bearish = obv < obv_ma

// ─── 7. RSI ─────────────────────────────────────────────────────────────────
rsi_ob = rsi_val > 70

// ─── 8. MOMENTUM ACCELERATION FILTER ───────────────────────────────────────
// The V9 experiment showed momentum filter improves PF from 1.36 → 1.54
// by filtering out 34% of signals where momentum accelerates AGAINST position.
// For SHORT: skip if price momentum is accelerating upward.
mom_fast = ta.ema(close, 6)
mom_slow = ta.ema(close, mom_accel_len)
mom_accel = (mom_fast - mom_slow) - (mom_fast[1] - mom_slow[1])  // acceleration
// For shorts: negative accel = price decelerating upward (good for shorts)
mom_filter_ok = not use_mom_filter or mom_accel <= 0

// ─── COMPOSITE SHORT SCORE ─────────────────────────────────────────────────
// Scoring tuned for SHORT-only (all top V9 strategies are short)

// Trend regime (Hurst)
trend_regime = math.max(math.min((hurst - 0.3) / 0.4, 1.0), 0.0)

// Autocorrelation (negative = reversal likely = good for shorts after up-move)
auto_score_short = math.max(math.min((0.3 - autocorr1) / 0.6, 1.0), 0.0)

// Predictability (low entropy = good)
predict_score = math.max(1.0 - entropy, 0.0)

// Momentum alignment (bearish)
mom_score_short = mom_alignment_short

// Volume confirms (bearish OBV)
vol_score_short = obv_bearish ? 0.7 : 0.3

// RSI overbought = good for short
rsi_score_short = rsi_ob ? 1.0 : rsi_val > 50 ? 0.6 : rsi_val < 30 ? 0.2 : 0.4

// GK Vol regime
gk_mean = ta.sma(gk_vol, 100)
gk_ratio = gk_vol / (gk_mean + 1e-10)
vol_regime_score = gk_ratio > 0.5 and gk_ratio < 2.0 ? 0.7 : 0.3

// Weighted composite
w_trend  = 0.25
w_auto   = 0.15
w_pred   = 0.15
w_mom    = 0.20
w_vol    = 0.10
w_rsi    = 0.05
w_gk     = 0.10

short_score = w_trend * trend_regime +
              w_auto  * auto_score_short +
              w_pred  * predict_score +
              w_mom   * mom_score_short +
              w_vol   * vol_score_short +
              w_rsi   * rsi_score_short +
              w_gk    * vol_regime_score

// ─── FILTERS ────────────────────────────────────────────────────────────────
regime_ok = atr_pct >= min_atr_pct

// Time filter: skip 06:00-10:00 UTC (low liquidity, hurts performance)
utc_hour = hour(time, "UTC")
time_ok = skip_low_liq ? not (utc_hour >= 6 and utc_hour < 10) : true

// ─── POSITION SIZING ────────────────────────────────────────────────────────
// Vol-scaled: reduce size when vol is high, increase when low
size_pct = use_vol_scale ? math.min(25.0 * vol_scale_target / math.max(atr_pct, 0.1), 25.0) : 25.0

// ─── ENTRY CONDITION ────────────────────────────────────────────────────────
short_entry = short_score >= score_thr and
              regime_ok and time_ok and
              mom_filter_ok

// ─── POSITION MANAGEMENT ───────────────────────────────────────────────────
var int bars_in_trade = 0
var float entry_atr = na

if strategy.position_size != 0
    bars_in_trade += 1
else
    bars_in_trade := 0
    entry_atr := na

// ─── EXECUTE SHORT ENTRIES ──────────────────────────────────────────────────
if short_entry and strategy.position_size == 0
    entry_atr := atr_val
    float sl_price = close + sl_mult * atr_val
    float tp_price = close - tp_mult * atr_val
    strategy.entry("SHORT", strategy.short, qty=size_pct)
    strategy.exit("Trail S", "SHORT",
         stop=sl_price,
         limit=tp_price,
         trail_offset=math.round(trail_mult * atr_val / syminfo.mintick),
         trail_points=math.round(0.5 * atr_val / syminfo.mintick))
    bars_in_trade := 0

// ─── MAX HOLD EXIT ──────────────────────────────────────────────────────────
if bars_in_trade >= max_hold and strategy.position_size != 0
    strategy.close_all("Max Hold")
    bars_in_trade := 0

// ─── PLOTTING ───────────────────────────────────────────────────────────────
var float plot_sl = na
var float plot_tp = na

if strategy.position_size < 0
    plot_sl := strategy.position_avg_price + sl_mult * nz(entry_atr, atr_val)
    plot_tp := strategy.position_avg_price - tp_mult * nz(entry_atr, atr_val)
else
    plot_sl := na
    plot_tp := na

plot(plot_sl, "Stop Loss", color=color.new(color.red, 30), style=plot.style_linebr, linewidth=2)
plot(plot_tp, "Take Profit", color=color.new(color.green, 30), style=plot.style_linebr, linewidth=2)

plotshape(short_entry and strategy.position_size == 0,
     "SELL", shape.labeldown, location.abovebar,
     color=color.new(color.red, 0), text="SHORT", textcolor=color.white, size=size.normal)

// Low-liquidity hours background
bgcolor(skip_low_liq and (utc_hour >= 6 and utc_hour < 10) ? color.new(color.yellow, 95) : na, title="Skip Hours")
bgcolor(not regime_ok ? color.new(color.gray, 92) : na, title="Low Vol")
bgcolor(strategy.position_size < 0 ? color.new(color.red, 93) : na, title="In Short")

// Momentum filter blocked
plotshape(short_score >= score_thr and regime_ok and time_ok and not mom_filter_ok and strategy.position_size == 0,
     "Filtered", shape.xcross, location.abovebar,
     color=color.new(color.orange, 30), size=size.tiny)

// ─── INFO TABLE ─────────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 14, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.new(color.gray, 60))

if barstate.islast
    mode_text = use_precision ? "A: Precision (PF 1.54)" : "B: Volume (PF 1.50)"
    table.cell(info, 0, 0, "V9 SHORT-ONLY", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(info, 1, 0, mode_text, text_color=color.yellow, text_size=size.small)

    table.cell(info, 0, 1, "Hurst", text_color=color.gray, text_size=size.small)
    h_color = hurst > 0.55 ? color.lime : hurst < 0.45 ? color.orange : color.yellow
    h_text  = hurst > 0.55 ? "TREND" : hurst < 0.45 ? "REVERT" : "RANDOM"
    table.cell(info, 1, 1, str.tostring(hurst, "#.##") + "  " + h_text, text_color=h_color, text_size=size.small)

    table.cell(info, 0, 2, "Autocorr", text_color=color.gray, text_size=size.small)
    a_color = autocorr1 > 0.05 ? color.lime : autocorr1 < -0.05 ? color.orange : color.yellow
    table.cell(info, 1, 2, str.tostring(autocorr1, "+#.###;-#.###"), text_color=a_color, text_size=size.small)

    table.cell(info, 0, 3, "Entropy", text_color=color.gray, text_size=size.small)
    e_color = entropy < 0.75 ? color.lime : entropy > 0.9 ? color.orange : color.yellow
    e_text  = entropy < 0.75 ? "PREDICT" : entropy > 0.9 ? "NOISY" : "MIXED"
    table.cell(info, 1, 3, str.tostring(entropy, "#.##") + "  " + e_text, text_color=e_color, text_size=size.small)

    table.cell(info, 0, 4, "Momentum", text_color=color.gray, text_size=size.small)
    m_color = mom_alignment_short > 0.6 ? color.lime : mom_alignment_short < 0.4 ? color.orange : color.yellow
    m_text  = str.tostring(bear_count, "#") + "/6 bear"
    table.cell(info, 1, 4, m_text, text_color=m_color, text_size=size.small)

    table.cell(info, 0, 5, "OBV Trend", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 5, obv_bearish ? "BEARISH ✓" : "BULLISH ✗", text_color=obv_bearish ? color.lime : color.orange, text_size=size.small)

    table.cell(info, 0, 6, "RSI", text_color=color.gray, text_size=size.small)
    rsi_color = rsi_ob ? color.lime : rsi_val > 50 ? color.yellow : color.orange
    table.cell(info, 1, 6, str.tostring(rsi_val, "#.#") + (rsi_ob ? " OB ✓" : ""), text_color=rsi_color, text_size=size.small)

    table.cell(info, 0, 7, "ATR Regime", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 7, regime_ok ? "OK  " + str.tostring(atr_pct, "#.##") + "%" : "LOW  " + str.tostring(atr_pct, "#.##") + "%",
         text_color=regime_ok ? color.lime : color.red, text_size=size.small)

    table.cell(info, 0, 8, "Mom Filter", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 8, mom_filter_ok ? "PASS ✓" : "BLOCKED ✗", text_color=mom_filter_ok ? color.lime : color.red, text_size=size.small)

    table.cell(info, 0, 9, "Hour Filter", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 9, time_ok ? "OK" : "SKIP (06-10 UTC)", text_color=time_ok ? color.lime : color.orange, text_size=size.small)

    table.cell(info, 0, 10, "Size %", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 10, str.tostring(size_pct, "#.#") + "%", text_color=color.white, text_size=size.small)

    table.cell(info, 0, 11, " ", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 11, " ", text_color=color.gray, text_size=size.tiny)

    table.cell(info, 0, 12, "SHORT Score", text_color=color.gray, text_size=size.small)
    ss_color = short_score >= score_thr and regime_ok ? color.orange : color.white
    table.cell(info, 1, 12, str.tostring(short_score, "#.###") + (short_score >= score_thr ? " ✓" : ""), text_color=ss_color, text_size=size.small)

    pos_text = strategy.position_size < 0 ? "🔴 SHORT" : short_entry ? "🔴 SELL NOW" : "⚪ FLAT"
    pos_color = strategy.position_size < 0 ? color.orange : short_entry ? color.orange : color.gray
    table.cell(info, 0, 13, "Position", text_color=color.white, text_size=size.normal)
    table.cell(info, 1, 13, pos_text + (bars_in_trade > 0 ? "  " + str.tostring(bars_in_trade) + "/" + str.tostring(max_hold) + " bars" : ""), text_color=pos_color, text_size=size.normal)

// ─── ALERTS ─────────────────────────────────────────────────────────────────
alertcondition(short_entry and strategy.position_size == 0, "SHORT Signal",
     "BTC V9: SHORT signal — Score={{plot_0}}")
alertcondition(not regime_ok[1] and regime_ok, "Regime OK",
     "BTC V9: Volatility regime restored, ready to trade")
