// =============================================================================
// BTC 8H Regression Model — STRATEGY
// =============================================================================
//
// Pine Script STRATEGY that replicates the key signals from the ML model.
// Use on BTCUSDT Perpetual, 1H timeframe.
//
// The ML model (XGBoost + LightGBM) predicts 8h forward returns using 117
// features. This strategy approximates the top features in Pine Script:
//   1. Hurst Exponent — trending vs mean-reverting detection
//   2. Autocorrelation — momentum persistence
//   3. Return Entropy — market predictability
//   4. Multi-horizon momentum alignment
//   5. Garman-Klass volatility regime
//   6. RSI divergence from momentum
//   7. Volume pressure (OBV trend)
//
// V6 backtest results (Python, 5 years):
//   PF=1.54, WR=47%, Sharpe=4.06, MaxDD=2.0%, +$4,897 on $25K
//
// =============================================================================

//@version=6
strategy("BTC 8H Regression Strategy", overlay=true,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=25,
     initial_capital=25000,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     slippage=1,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=false,
     max_bars_back=500)

// ─── INPUTS ─────────────────────────────────────────────────────────────────
grp_entry = "Entry Settings"
sl_mult    = input.float(1.5, "Stop Loss (× ATR)", step=0.1, group=grp_entry, tooltip="From V6 backtest: 1.5 ATR")
tp_mult    = input.float(3.0, "Take Profit (× ATR)", step=0.1, group=grp_entry, tooltip="From V6 backtest: 3.0 ATR")
trail_mult = input.float(0.75, "Trailing Stop (× ATR)", step=0.05, group=grp_entry, tooltip="From V6 backtest: 0.75 ATR")
max_hold   = input.int(12, "Max Hold Bars", minval=1, group=grp_entry, tooltip="Close after 12 bars (12h on 1H chart)")
use_trail  = input.bool(true, "Use Trailing Stop", group=grp_entry)
atr_len    = input.int(14, "ATR Length", group=grp_entry)

grp_filter = "Signal Filters"
min_atr_pct     = input.float(0.4, "Min ATR% (regime filter)", step=0.05, group=grp_filter, tooltip="Skip low-volatility periods")
hurst_len       = input.int(100, "Hurst Lookback", minval=50, group=grp_filter)
auto_len        = input.int(48, "Autocorrelation Lookback", minval=10, group=grp_filter)
ent_len         = input.int(48, "Entropy Lookback", minval=20, group=grp_filter)
rsi_len         = input.int(14, "RSI Length", group=grp_filter)
score_thr_long  = input.float(0.55, "Long Score Threshold", step=0.05, minval=0, maxval=1, group=grp_filter)
score_thr_short = input.float(0.55, "Short Score Threshold", step=0.05, minval=0, maxval=1, group=grp_filter)

grp_dir = "Direction"
trade_long  = input.bool(true, "Allow Long", group=grp_dir)
trade_short = input.bool(true, "Allow Short", group=grp_dir)

grp_time = "Time Filter"
use_time_filter = input.bool(false, "Use Session Filter", group=grp_time)
sess = input.session("0800-2000", "Trading Session (UTC)", group=grp_time)

// ─── CORE CALCULATIONS ─────────────────────────────────────────────────────

log_ret = math.log(close / close[1])
atr_val = ta.atr(atr_len)
atr_pct = atr_val / close * 100
rsi_val = ta.rsi(close, rsi_len)

// ─── 1. HURST EXPONENT ─────────────────────────────────────────────────────
// H > 0.5 = trending (go with momentum)
// H < 0.5 = mean-reverting (fade moves)
// #1 most important feature in the model

hurst_calc() =>
    float sum_log_tau = 0.0
    float sum_log_lag = 0.0
    float sum_cross = 0.0
    float sum_log_lag_sq = 0.0
    int count = 0
    for lag = 2 to 20
        float tau = 0.0
        for j = 0 to hurst_len - lag - 1
            diff = close[j] - close[j + lag]
            tau += diff * diff
        tau := math.sqrt(tau / math.max(hurst_len - lag, 1))
        if tau > 0
            float lt = math.log(tau)
            float ll = math.log(lag)
            sum_log_tau += lt
            sum_log_lag += ll
            sum_cross += lt * ll
            sum_log_lag_sq += ll * ll
            count += 1
    if count > 1
        float denom = count * sum_log_lag_sq - sum_log_lag * sum_log_lag
        denom != 0 ? (count * sum_cross - sum_log_lag * sum_log_tau) / denom : 0.5
    else
        0.5

hurst = hurst_calc()

// ─── 2. AUTOCORRELATION (lag-1 and lag-5) ───────────────────────────────────
// Positive autocorr = momentum continues, Negative = reversal likely
// #4 and #16 most important features

autocorr(int lookback, int lag) =>
    float sx = 0.0, float sy = 0.0, float sxy = 0.0
    float sx2 = 0.0, float sy2 = 0.0
    int n = lookback - lag
    for i = 0 to n - 1
        float x = nz(log_ret[i + lag])
        float y = nz(log_ret[i])
        sx += x
        sy += y
        sxy += x * y
        sx2 += x * x
        sy2 += y * y
    float denom = math.sqrt((n * sx2 - sx * sx) * (n * sy2 - sy * sy))
    denom != 0 ? (n * sxy - sx * sy) / denom : 0.0

autocorr1 = autocorr(auto_len, 1)
autocorr5 = autocorr(auto_len, 5)

// ─── 3. RETURN ENTROPY ─────────────────────────────────────────────────────
// Low entropy = predictable market (good for trading)
// High entropy = random/noisy (avoid)
// #3 most important feature

entropy_calc() =>
    float min_r = 1e10
    float max_r = -1e10
    for i = 0 to ent_len - 1
        float r = nz(log_ret[i])
        min_r := math.min(min_r, r)
        max_r := math.max(max_r, r)
    float bw = (max_r - min_r + 1e-10) / 10.0
    array<float> bins = array.new_float(10, 0.0)
    float total = 0.0
    for i = 0 to ent_len - 1
        float r = nz(log_ret[i])
        int bi = math.min(int((r - min_r) / bw), 9)
        array.set(bins, bi, array.get(bins, bi) + 1.0)
        total += 1.0
    float ent = 0.0
    for b = 0 to 9
        float p = array.get(bins, b) / total
        if p > 0
            ent -= p * math.log(p)
    ent / math.log(10)  // Normalise to 0-1

entropy = entropy_calc()

// ─── 4. GARMAN-KLASS VOLATILITY ────────────────────────────────────────────
// More efficient than close-to-close vol. #7 in importance.
gk_bar = 0.5 * math.pow(math.log(high / low), 2) - (2 * math.log(2) - 1) * math.pow(math.log(close / open), 2)
gk_vol = math.sqrt(math.max(ta.sma(gk_bar, 24), 0))

// ─── 5. MULTI-HORIZON MOMENTUM ─────────────────────────────────────────────
// The model checks momentum at 1h, 4h, 12h, 24h, 72h, 168h
// Alignment of all = strong signal. 168h momentum is #12 in importance.

mom_1h   = log_ret
mom_4h   = math.log(close / close[4])
mom_12h  = math.log(close / close[12])
mom_24h  = math.log(close / close[24])
mom_72h  = math.log(close / close[72])
mom_168h = math.log(close / close[168])

// Bullish alignment: what fraction of timeframes point up
bull_count = (mom_1h > 0 ? 1.0 : 0.0) + (mom_4h > 0 ? 1.0 : 0.0) +
             (mom_12h > 0 ? 1.0 : 0.0) + (mom_24h > 0 ? 1.0 : 0.0) +
             (mom_72h > 0 ? 1.0 : 0.0) + (mom_168h > 0 ? 1.0 : 0.0)
mom_alignment = bull_count / 6.0  // 1.0 = all bullish, 0.0 = all bearish

// ─── 6. VOLUME PRESSURE (OBV trend) ────────────────────────────────────────
// #9 in importance
obv = ta.obv
obv_ma = ta.sma(obv, 20)
obv_bullish = obv > obv_ma

// ─── 7. RSI EXTREMES ───────────────────────────────────────────────────────
// RSI at 1D timeframe is #15 in importance
// We use standard RSI for overbought/oversold confirmation
rsi_ob = rsi_val > 70
rsi_os = rsi_val < 30

// ─── COMPOSITE SCORING ─────────────────────────────────────────────────────
// Each sub-score is normalised to 0-1 range, then combined with weights
// matching approximate feature importance from the model.

// --- Trend regime score (0-1): higher when market is trending ---
// Hurst > 0.5 = trending. Scale linearly from 0.3 to 0.7 → 0 to 1
trend_regime = math.max(math.min((hurst - 0.3) / 0.4, 1.0), 0.0)

// --- Autocorrelation score (0-1): higher when momentum persists ---
// autocorr1 typically ranges -0.3 to +0.3. Scale to 0-1
auto_score_long  = math.max(math.min((autocorr1 + 0.3) / 0.6, 1.0), 0.0)
auto_score_short = 1.0 - auto_score_long

// --- Predictability score (0-1): higher when entropy is low ---
predict_score = math.max(1.0 - entropy, 0.0)

// --- Momentum score (0-1) ---
mom_score_long  = mom_alignment
mom_score_short = 1.0 - mom_alignment

// --- Volume score (0-1) ---
vol_score_long  = obv_bullish ? 0.7 : 0.3
vol_score_short = obv_bullish ? 0.3 : 0.7

// --- RSI confirmation (0-1) ---
rsi_score_long  = rsi_os ? 1.0 : rsi_val < 50 ? 0.6 : rsi_ob ? 0.2 : 0.4
rsi_score_short = rsi_ob ? 1.0 : rsi_val > 50 ? 0.6 : rsi_os ? 0.2 : 0.4

// --- GK Vol regime (0-1): prefer moderate vol, not too low not too high ---
gk_mean = ta.sma(gk_vol, 100)
gk_ratio = gk_vol / (gk_mean + 1e-10)
vol_regime_score = gk_ratio > 0.5 and gk_ratio < 2.0 ? 0.7 : 0.3

// ─── WEIGHTED COMPOSITE ────────────────────────────────────────────────────
// Weights roughly proportional to model feature importance
w_trend  = 0.25   // Hurst (#1)
w_auto   = 0.15   // Autocorrelation (#4)
w_pred   = 0.15   // Entropy (#3)
w_mom    = 0.20   // Momentum alignment (#12, plus mom features)
w_vol    = 0.10   // OBV (#9)
w_rsi    = 0.05   // RSI (#15)
w_gk     = 0.10   // GK vol (#7)

long_score  = w_trend * trend_regime +
              w_auto  * auto_score_long +
              w_pred  * predict_score +
              w_mom   * mom_score_long +
              w_vol   * vol_score_long +
              w_rsi   * rsi_score_long +
              w_gk    * vol_regime_score

short_score = w_trend * trend_regime +
              w_auto  * auto_score_short +
              w_pred  * predict_score +
              w_mom   * mom_score_short +
              w_vol   * vol_score_short +
              w_rsi   * rsi_score_short +
              w_gk    * vol_regime_score

// ─── REGIME FILTER ──────────────────────────────────────────────────────────
regime_ok = atr_pct >= min_atr_pct

// Time filter
in_session = use_time_filter ? not na(time(timeframe.period, sess)) : true

// ─── ENTRY CONDITIONS ───────────────────────────────────────────────────────
long_entry  = long_score >= score_thr_long and
              long_score > short_score and
              regime_ok and in_session and trade_long

short_entry = short_score >= score_thr_short and
              short_score > long_score and
              regime_ok and in_session and trade_short

// ─── POSITION MANAGEMENT ───────────────────────────────────────────────────
var int bars_in_trade = 0
var float entry_atr = na

if strategy.position_size != 0
    bars_in_trade += 1
else
    bars_in_trade := 0
    entry_atr := na

// ─── EXECUTE ENTRIES ────────────────────────────────────────────────────────
if long_entry and strategy.position_size == 0
    entry_atr := atr_val
    float sl_price = close - sl_mult * atr_val
    float tp_price = close + tp_mult * atr_val
    strategy.entry("LONG", strategy.long)
    if use_trail
        strategy.exit("Trail L", "LONG",
             stop=sl_price,
             limit=tp_price,
             trail_offset=math.round(trail_mult * atr_val / syminfo.mintick),
             trail_points=math.round(0.5 * atr_val / syminfo.mintick))
    else
        strategy.exit("Exit L", "LONG", stop=sl_price, limit=tp_price)
    bars_in_trade := 0

if short_entry and strategy.position_size == 0
    entry_atr := atr_val
    float sl_price = close + sl_mult * atr_val
    float tp_price = close - tp_mult * atr_val
    strategy.entry("SHORT", strategy.short)
    if use_trail
        strategy.exit("Trail S", "SHORT",
             stop=sl_price,
             limit=tp_price,
             trail_offset=math.round(trail_mult * atr_val / syminfo.mintick),
             trail_points=math.round(0.5 * atr_val / syminfo.mintick))
    else
        strategy.exit("Exit S", "SHORT", stop=sl_price, limit=tp_price)
    bars_in_trade := 0

// ─── MAX HOLD EXIT ──────────────────────────────────────────────────────────
if bars_in_trade >= max_hold and strategy.position_size != 0
    strategy.close_all("Max Hold")
    bars_in_trade := 0

// ─── PLOTTING (on chart) ───────────────────────────────────────────────────

// SL / TP lines while in position
var float plot_sl = na
var float plot_tp = na

if strategy.position_size > 0
    plot_sl := strategy.position_avg_price - sl_mult * nz(entry_atr, atr_val)
    plot_tp := strategy.position_avg_price + tp_mult * nz(entry_atr, atr_val)
else if strategy.position_size < 0
    plot_sl := strategy.position_avg_price + sl_mult * nz(entry_atr, atr_val)
    plot_tp := strategy.position_avg_price - tp_mult * nz(entry_atr, atr_val)
else
    plot_sl := na
    plot_tp := na

plot(plot_sl, "Stop Loss", color=color.new(color.red, 30), style=plot.style_linebr, linewidth=2)
plot(plot_tp, "Take Profit", color=color.new(color.green, 30), style=plot.style_linebr, linewidth=2)

// Entry signals
plotshape(long_entry and strategy.position_size == 0,
     "BUY", shape.labelup, location.belowbar,
     color=color.new(color.green, 0), text="BUY", textcolor=color.white, size=size.normal)

plotshape(short_entry and strategy.position_size == 0,
     "SELL", shape.labeldown, location.abovebar,
     color=color.new(color.red, 0), text="SELL", textcolor=color.white, size=size.normal)

// Regime background
bgcolor(not regime_ok ? color.new(color.gray, 92) : na, title="Low Vol (skip)")
bgcolor(strategy.position_size > 0 ? color.new(color.green, 93) : na, title="In Long")
bgcolor(strategy.position_size < 0 ? color.new(color.red, 93) : na, title="In Short")

// ─── INFO TABLE ─────────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.new(color.gray, 60))

if barstate.islast
    table.cell(info, 0, 0, "8H Regression Model", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(info, 1, 0, "", text_color=color.white)

    table.cell(info, 0, 1, "Hurst", text_color=color.gray, text_size=size.small)
    h_color = hurst > 0.55 ? color.lime : hurst < 0.45 ? color.orange : color.yellow
    h_text  = hurst > 0.55 ? "TREND" : hurst < 0.45 ? "REVERT" : "RANDOM"
    table.cell(info, 1, 1, str.tostring(hurst, "#.##") + "  " + h_text, text_color=h_color, text_size=size.small)

    table.cell(info, 0, 2, "Autocorr", text_color=color.gray, text_size=size.small)
    a_color = autocorr1 > 0.05 ? color.lime : autocorr1 < -0.05 ? color.orange : color.yellow
    table.cell(info, 1, 2, str.tostring(autocorr1, "+#.###;-#.###"), text_color=a_color, text_size=size.small)

    table.cell(info, 0, 3, "Entropy", text_color=color.gray, text_size=size.small)
    e_color = entropy < 0.75 ? color.lime : entropy > 0.9 ? color.orange : color.yellow
    e_text  = entropy < 0.75 ? "PREDICTABLE" : entropy > 0.9 ? "NOISY" : "MIXED"
    table.cell(info, 1, 3, str.tostring(entropy, "#.##") + "  " + e_text, text_color=e_color, text_size=size.small)

    table.cell(info, 0, 4, "Momentum", text_color=color.gray, text_size=size.small)
    m_color = mom_alignment > 0.6 ? color.lime : mom_alignment < 0.4 ? color.orange : color.yellow
    m_text  = str.tostring(bull_count, "#") + "/6 bull"
    table.cell(info, 1, 4, m_text, text_color=m_color, text_size=size.small)

    table.cell(info, 0, 5, "OBV Trend", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 5, obv_bullish ? "BULLISH" : "BEARISH", text_color=obv_bullish ? color.lime : color.orange, text_size=size.small)

    table.cell(info, 0, 6, "RSI", text_color=color.gray, text_size=size.small)
    rsi_color = rsi_os ? color.lime : rsi_ob ? color.orange : color.white
    table.cell(info, 1, 6, str.tostring(rsi_val, "#.#"), text_color=rsi_color, text_size=size.small)

    table.cell(info, 0, 7, "ATR Regime", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 7, regime_ok ? "OK  " + str.tostring(atr_pct, "#.##") + "%" : "LOW VOL  " + str.tostring(atr_pct, "#.##") + "%",
         text_color=regime_ok ? color.lime : color.red, text_size=size.small)

    table.cell(info, 0, 8, " ", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 8, " ", text_color=color.gray, text_size=size.tiny)

    table.cell(info, 0, 9, "LONG Score", text_color=color.gray, text_size=size.small)
    ls_color = long_score >= score_thr_long and regime_ok ? color.lime : color.white
    table.cell(info, 1, 9, str.tostring(long_score, "#.###") + (long_score >= score_thr_long ? " ✓" : ""), text_color=ls_color, text_size=size.small)

    table.cell(info, 0, 10, "SHORT Score", text_color=color.gray, text_size=size.small)
    ss_color = short_score >= score_thr_short and regime_ok ? color.orange : color.white
    table.cell(info, 1, 10, str.tostring(short_score, "#.###") + (short_score >= score_thr_short ? " ✓" : ""), text_color=ss_color, text_size=size.small)

    pos_text = strategy.position_size > 0 ? "🟢 LONG" : strategy.position_size < 0 ? "🔴 SHORT" : long_entry ? "🟢 BUY NOW" : short_entry ? "🔴 SELL NOW" : "⚪ FLAT"
    pos_color = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.orange : long_entry ? color.lime : short_entry ? color.orange : color.gray
    table.cell(info, 0, 11, "Position", text_color=color.white, text_size=size.normal)
    table.cell(info, 1, 11, pos_text + (bars_in_trade > 0 ? "  " + str.tostring(bars_in_trade) + "/" + str.tostring(max_hold) + " bars" : ""), text_color=pos_color, text_size=size.normal)

// ─── ALERTS ─────────────────────────────────────────────────────────────────
alertcondition(long_entry and strategy.position_size == 0, "BUY Signal",
     "BTC 8H Model: BUY signal — Long score={{plot_0}}")
alertcondition(short_entry and strategy.position_size == 0, "SELL Signal",
     "BTC 8H Model: SELL signal — Short score={{plot_0}}")
alertcondition(not regime_ok[1] and regime_ok, "Regime OK",
     "BTC 8H Model: Volatility regime OK, ready to trade")
