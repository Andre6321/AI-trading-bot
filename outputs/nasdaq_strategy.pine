// =============================================================================
// NASDAQ QQQ — MULTI-EDGE LONG STRATEGY  (V3 FINAL)
// =============================================================================
//
// 92 strategy configs tested across V1–V3, walk-forward validated.
// Use on QQQ (or NAS100/USNAS100) on the DAILY timeframe.
//
// FIVE EDGES — each fires independently, conviction scales when they overlap:
//
//  Edge │ Condition                         │  PF  │ Sharpe │ Trades/yr
//  ─────┼───────────────────────────────────┼──────┼────────┼──────────
//   E1  │ 3+ down days, VIX<25             │ 2.09 │ +3.58  │  ~14
//   E2  │ Monday or Wednesday, VIX<20      │ 1.55 │ +2.61  │  ~69
//   E3  │ VIX < 15 (calm regime)           │ 1.56 │ +2.58  │  ~95
//   E4  │ 3+down + gap down >0.3%          │ 3.30 │ +5.88  │   ~4
//   E5  │ First 3 days of month, VIX<20    │ 1.44 │ +2.26  │  ~25
//
// CONVICTION SYSTEM — When edges overlap, increase size:
//   1 edge  = base size      │  2 edges = +30%
//   3 edges = +60%           │  4+ edges = +100%  (rare, ~1-2×/yr)
//   Backtest: Regime stacking → PF 1.66, $1,059 P&L  (p<0.0001)
//
// V3 BOOSTS (applied automatically):
//   • Gap-down on streak day → +3% extra (PF 3.30)
//   • VIX 20-25 sweet spot   → E1 gets +20% size (PF 2.67)
//   • Earnings season skip   → optional, PF 2.09→1.89 (cleaner)
//   • ATR regime sizing      → low ATR +60% size, high ATR −40%
//   • Depth-weighted sizing  → ≥5% drop = 2× size, ≥3% = 1.4×
//
// Walk-Forward (train 7yr → test 3yr):
//   E1: PF 2.09 → 2.08  ✅  │  E2: PF 1.68 → 1.37  ✅
//
// vs Buy & Hold:  Sharpe 3.14 vs 0.95  │  DD 0.33% vs 35%
// =============================================================================

//@version=6
strategy("NASDAQ Multi-Edge V3", overlay=true,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=5,
     initial_capital=25000,
     commission_type=strategy.commission.percent,
     commission_value=0.01,
     slippage=1,
     pyramiding=5,
     calc_on_every_tick=false,
     process_orders_on_close=false,
     max_bars_back=500)

// ─── INPUTS ─────────────────────────────────────────────────────────────────

grp_mode = "Edge Toggles"
use_edge1 = input.bool(true, "E1: Mean Reversion  (PF 2.09)", group=grp_mode)
use_edge2 = input.bool(true, "E2: Mon/Wed Day-of-Week  (PF 1.55)", group=grp_mode)
use_edge3 = input.bool(true, "E3: Calm Market VIX<15  (PF 1.56)", group=grp_mode)
use_edge4 = input.bool(true, "E4: Gap-Down Bounce  (PF 3.30)", group=grp_mode)
use_edge5 = input.bool(true, "E5: Month-Start Flow  (PF 1.44)", group=grp_mode)

grp_vix = "VIX Thresholds"
vix_ticker     = input.string("VIX", "VIX Ticker", group=grp_vix)
vix_max_e1     = input.float(25.0, "E1 Max VIX (panic cutoff)", step=1, group=grp_vix)
vix_max_e2     = input.float(20.0, "E2/E5 Max VIX", step=1, group=grp_vix)
vix_max_e3     = input.float(15.0, "E3 Max VIX (calm)", step=1, group=grp_vix)

grp_mr = "Mean Reversion"
min_streak      = input.int(3, "Min Down Days", minval=2, maxval=6, group=grp_mr)
use_depth_size  = input.bool(true, "Depth-Weighted Sizing (≥5%→2×, ≥3%→1.4×)", group=grp_mr)

grp_v3 = "V3 Enhancements"
use_conviction  = input.bool(true, "Conviction Scaling (overlap → bigger size)", group=grp_v3,
     tooltip="When multiple edges fire on the same bar, increase total\nposition by +30% per extra edge. Backtested PF 1.66.")
use_atr_sizing  = input.bool(true, "ATR Regime Sizing (calm→+60%, volatile→−40%)", group=grp_v3,
     tooltip="Low ATR regime → more size (calmer bounce).\nHigh ATR → reduce size (wider swings). PF 1.82.")
use_vix_sweet   = input.bool(true, "VIX 20-25 Sweet Spot (+20% on E1)", group=grp_v3,
     tooltip="When VIX is 20-25, E1 bounce is stronger. PF 2.67.\nAutomatically boosts E1 position by 20%.")
use_skip_earn   = input.bool(false, "Skip Earnings Season (mid-Jan/Apr/Jul/Oct)", group=grp_v3,
     tooltip="Avoid 10th-27th of earnings months.\nPF 2.09→1.89 but cleaner trades, fewer surprises.")

grp_trail = "Trailing Stop (Multi-Day Hold)"
use_trail       = input.bool(false, "Use Trailing Stop (up to N days)", group=grp_trail,
     tooltip="Hold with trailing stop instead of same-day close.\nPF 86.86, WR 95.7%, but very few trades.")
trail_pct       = input.float(0.5, "Trail Lock-In (% of max profit)", step=0.1, minval=0.1, maxval=0.9, group=grp_trail)
initial_sl_pct  = input.float(1.0, "Initial Stop Loss %", step=0.1, group=grp_trail)
max_hold_days   = input.int(5, "Max Hold Days", minval=1, maxval=10, group=grp_trail)

grp_filter = "Macro Filters"
use_sma200      = input.bool(false, "SMA200 Trend Filter", group=grp_filter)
use_season      = input.bool(false, "Seasonality (Nov-Apr only)", group=grp_filter)
use_golden      = input.bool(false, "Golden Cross (SMA50>SMA200)", group=grp_filter)

grp_sz = "Base Position Sizes"
sz_e1  = input.float(5.0, "E1 Base %", step=0.5, group=grp_sz)
sz_e2  = input.float(3.0, "E2 Base %", step=0.5, group=grp_sz)
sz_e3  = input.float(2.0, "E3 Base %", step=0.5, group=grp_sz)
sz_e4  = input.float(3.0, "E4 Base %", step=0.5, group=grp_sz)
sz_e5  = input.float(2.0, "E5 Base %", step=0.5, group=grp_sz)
max_total_size = input.float(15.0, "Max Total Exposure %", step=1, group=grp_sz,
     tooltip="Cap total position across all edges to prevent over-sizing.")

// ─── VIX DATA ───────────────────────────────────────────────────────────────
vix_val = request.security(vix_ticker, "D", close, barmerge.gaps_off, barmerge.lookahead_on)

// ─── CORE CALCULATIONS ─────────────────────────────────────────────────────
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
atr14  = ta.atr(14)

// ATR percentile rank (252-day rolling)
atr_pct = atr14 / close * 100
atr_rank = ta.percentrank(atr_pct, 252)  // 0-100

// SMA200 distance
sma200_dist = not na(sma200) ? (close - sma200) / sma200 * 100 : 0.0

// ── Down-streak counter ──
is_red = close < open
var int down_streak = 0
if is_red
    down_streak += 1
else
    down_streak := 0

var float cum_drop = 0.0
daily_ret = na(close[1]) ? 0.0 : (close - close[1]) / close[1] * 100
if is_red
    cum_drop += daily_ret
else
    cum_drop := 0.0

prev_streak = down_streak[1]
prev_drop   = math.abs(cum_drop[1])

// ── Day of week ──
dow = dayofweek
is_mon = dow == dayofweek.monday
is_wed = dow == dayofweek.wednesday

// ── Month & trading day of month ──
mth = month
in_best_months = mth >= 11 or mth <= 4
is_new_month = month != month[1]
var int tdom = 0        // trading day of month
if is_new_month
    tdom := 1
else
    tdom += 1

// ── Gap % (today open vs yesterday close) ──
gap_pct = na(close[1]) ? 0.0 : (open - close[1]) / close[1] * 100

// ── Earnings season (10th–27th of Jan, Apr, Jul, Oct) ──
earn_month = mth == 1 or mth == 4 or mth == 7 or mth == 10
dom = dayofmonth
in_earnings = earn_month and dom >= 10 and dom <= 27

// ─── MACRO FILTERS ──────────────────────────────────────────────────────────
sma200_ok  = use_sma200 ? (close > sma200 and not na(sma200)) : true
season_ok  = use_season ? in_best_months : true
golden_ok  = use_golden ? (sma50 > sma200 and not na(sma50) and not na(sma200)) : true
earn_ok    = use_skip_earn ? not in_earnings : true
all_ok     = sma200_ok and season_ok and golden_ok and earn_ok

// ─── EDGE SIGNALS ───────────────────────────────────────────────────────────

// E1 — Mean Reversion
vix_ok_1 = not na(vix_val) and vix_val < vix_max_e1
e1 = use_edge1 and prev_streak >= min_streak and vix_ok_1 and all_ok

// E2 — Day-of-Week
vix_ok_2 = not na(vix_val) and vix_val < vix_max_e2
e2 = use_edge2 and (is_mon or is_wed) and vix_ok_2 and all_ok

// E3 — Calm Market
vix_ok_3 = not na(vix_val) and vix_val < vix_max_e3
e3 = use_edge3 and vix_ok_3 and all_ok

// E4 — Gap-Down Bounce (fires WITH E1 as extra conviction)
e4 = use_edge4 and prev_streak >= min_streak and gap_pct < -0.3 and all_ok

// E5 — Month-Start Flow
e5 = use_edge5 and tdom <= 3 and vix_ok_2 and all_ok

// ─── CONVICTION SCORE ───────────────────────────────────────────────────────
// Count how many edges fire on this bar
edge_count = (e1 ? 1 : 0) + (e2 ? 1 : 0) + (e3 ? 1 : 0) + (e4 ? 1 : 0) + (e5 ? 1 : 0)
any_signal = edge_count > 0

// Conviction multiplier: each extra edge beyond 1 adds +30%
conv_mult = use_conviction ? (1.0 + math.max(edge_count - 1, 0) * 0.30) : 1.0

// VIX 20-25 sweet spot boost: E1 stronger when VIX is elevated-but-safe
vix_sweet = use_vix_sweet and not na(vix_val) and vix_val >= 20 and vix_val < 25
sweet_mult = vix_sweet and e1 ? 1.20 : 1.0

// ATR regime multiplier
atr_mult = 1.0
if use_atr_sizing and not na(atr_rank)
    if atr_rank < 30
        atr_mult := 1.60     // Calm market → more size
    else if atr_rank > 70
        atr_mult := 0.60     // Volatile → less size

// ─── POSITION SIZING ────────────────────────────────────────────────────────

// E1 depth-weighted base
e1_size = sz_e1
if use_depth_size and e1
    if prev_drop >= 5.0
        e1_size := sz_e1 * 2.0
    else if prev_drop >= 3.0
        e1_size := sz_e1 * 1.4
    else
        e1_size := sz_e1 * 0.8

// Apply VIX sweet spot boost to E1
e1_size := e1_size * sweet_mult

// Per-edge sizes
raw_total = (e1 ? e1_size : 0) + (e2 ? sz_e2 : 0) + (e3 ? sz_e3 : 0) + (e4 ? sz_e4 : 0) + (e5 ? sz_e5 : 0)

// Apply conviction + ATR multipliers
adj_total = raw_total * conv_mult * atr_mult

// Cap at max exposure
final_total = math.min(adj_total, max_total_size)
scale = adj_total > 0 ? final_total / adj_total : 1.0

// Final per-edge sizes (proportionally scaled if capped)
f_e1 = e1 ? e1_size * conv_mult * atr_mult * scale : 0.0
f_e2 = e2 ? sz_e2  * conv_mult * atr_mult * scale : 0.0
f_e3 = e3 ? sz_e3  * conv_mult * atr_mult * scale : 0.0
f_e4 = e4 ? sz_e4  * conv_mult * atr_mult * scale : 0.0
f_e5 = e5 ? sz_e5  * conv_mult * atr_mult * scale : 0.0

// ─── POSITION MANAGEMENT ───────────────────────────────────────────────────
var int bars_held = 0
var float max_profit_pct = 0.0
var float entry_price_track = na
var bool in_trail_trade = false

if strategy.position_size > 0
    bars_held += 1
    float cur_pnl = (close - entry_price_track) / entry_price_track * 100
    max_profit_pct := math.max(max_profit_pct, cur_pnl)
else
    bars_held := 0
    max_profit_pct := 0.0
    in_trail_trade := false
    entry_price_track := na

// ─── ENTRIES ────────────────────────────────────────────────────────────────
if e1 and not in_trail_trade
    if use_trail
        strategy.entry("MR_T", strategy.long, qty=f_e1)
        strategy.exit("MR_SL", "MR_T", stop=close * (1 - initial_sl_pct / 100))
        entry_price_track := close
        in_trail_trade := true
    else
        strategy.entry("MR", strategy.long, qty=f_e1)

if e2 and not in_trail_trade
    strategy.entry("DOW", strategy.long, qty=f_e2)

if e3 and not in_trail_trade
    strategy.entry("CALM", strategy.long, qty=f_e3)

if e4 and not in_trail_trade
    strategy.entry("GAP", strategy.long, qty=f_e4)

if e5 and not in_trail_trade
    strategy.entry("FLOW", strategy.long, qty=f_e5)

// ─── EXITS ──────────────────────────────────────────────────────────────────
if not use_trail and strategy.position_size > 0 and bars_held >= 1
    strategy.close_all("EOD Close")

if use_trail and in_trail_trade and strategy.position_size > 0
    if max_profit_pct > 0
        float tl = entry_price_track * (1 + max_profit_pct * trail_pct / 100)
        if tl > entry_price_track
            strategy.exit("Trail", "MR_T", stop=tl)
    if bars_held >= max_hold_days
        strategy.close_all("Max Hold")
        in_trail_trade := false

// ─── PLOTTING ───────────────────────────────────────────────────────────────

// ── Signal markers — colour by conviction ──
// Multi-edge convergence gets the big bright label
plotshape(edge_count >= 3 and strategy.position_size == 0,
     "3+ EDGES", shape.labelup, location.belowbar,
     color=color.new(color.yellow, 0), text="★★★", textcolor=color.black, size=size.large)

plotshape(edge_count == 2 and strategy.position_size == 0,
     "2 EDGES", shape.labelup, location.belowbar,
     color=color.new(color.lime, 0), text="★★", textcolor=color.black, size=size.normal)

plotshape(e4 and edge_count == 1 and strategy.position_size == 0,
     "GAP ONLY", shape.labelup, location.belowbar,
     color=color.new(color.purple, 0), text="GP", textcolor=color.white, size=size.normal)

plotshape(e1 and not e4 and edge_count == 1 and strategy.position_size == 0,
     "MR ONLY", shape.labelup, location.belowbar,
     color=color.new(color.green, 0), text="MR", textcolor=color.white, size=size.small)

plotshape(not e1 and not e4 and edge_count == 1 and strategy.position_size == 0,
     "SINGLE", shape.triangleup, location.belowbar,
     color=color.new(color.blue, 30), size=size.tiny)

// ── Streak flag ──
plotshape(down_streak >= min_streak,
     "Streak", shape.flag, location.abovebar,
     color=color.new(color.red, 40), size=size.tiny)

// ── SMA lines ──
plot(sma200, "SMA200", color=color.new(color.orange, 50), linewidth=1)
plot(sma50, "SMA50", color=color.new(color.blue, 60), linewidth=1)

// ── Background ──
bgcolor(not na(vix_val) and vix_val >= 25 ? color.new(color.red, 90) : na, title="VIX≥25 DANGER")
bgcolor(not na(vix_val) and vix_val < 15 ? color.new(color.green, 95) : na, title="VIX<15 Calm")
bgcolor(strategy.position_size > 0 ? color.new(color.green, 93) : na, title="In Long")
bgcolor(use_skip_earn and in_earnings ? color.new(color.orange, 93) : na, title="Earnings Season")

// ─── INFO TABLE ─────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 20,
     bgcolor=color.new(color.black, 75), border_width=1,
     border_color=color.new(color.gray, 60))

if barstate.islast
    // Row 0 — Title
    table.cell(t, 0, 0, "NASDAQ V3", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(t, 1, 0, str.tostring(edge_count) + " edge" + (edge_count != 1 ? "s" : ""),
         text_color=edge_count >= 3 ? color.yellow : edge_count >= 2 ? color.lime : edge_count == 1 ? color.aqua : color.gray,
         text_size=size.normal)

    // Row 1 — VIX
    table.cell(t, 0, 1, "VIX", text_color=color.gray, text_size=size.small)
    v_c = vix_val < 15 ? color.lime : vix_val < 20 ? color.yellow : vix_val < 25 ? color.orange : color.red
    v_l = vix_val < 15 ? " CALM" : vix_val < 20 ? " OK" : vix_val < 25 ? " SWEET ★" : " DANGER"
    table.cell(t, 1, 1, str.tostring(vix_val, "#.#") + v_l, text_color=v_c, text_size=size.small)

    // Row 2 — Down Streak
    table.cell(t, 0, 2, "Down Streak", text_color=color.gray, text_size=size.small)
    sc = down_streak >= min_streak ? color.lime : down_streak >= 2 ? color.yellow : color.white
    table.cell(t, 1, 2, str.tostring(down_streak) + " days" + (down_streak >= min_streak ? " ✓ BOUNCE" : ""),
         text_color=sc, text_size=size.small)

    // Row 3 — Cumulative Drop
    table.cell(t, 0, 3, "Streak Drop", text_color=color.gray, text_size=size.small)
    dc = math.abs(cum_drop) >= 5 ? color.lime : math.abs(cum_drop) >= 3 ? color.yellow : color.white
    dl = math.abs(cum_drop) >= 5 ? " DEEP" : math.abs(cum_drop) >= 3 ? " MED" : ""
    table.cell(t, 1, 3, str.tostring(cum_drop, "#.##") + "%" + dl, text_color=dc, text_size=size.small)

    // Row 4 — Gap
    table.cell(t, 0, 4, "Gap", text_color=color.gray, text_size=size.small)
    gc2 = gap_pct < -0.3 ? color.lime : color.white
    table.cell(t, 1, 4, str.tostring(gap_pct, "#.##") + "%" + (gap_pct < -0.3 ? " GAP DOWN ✓" : ""),
         text_color=gc2, text_size=size.small)

    // Row 5 — Day of Week
    table.cell(t, 0, 5, "Day", text_color=color.gray, text_size=size.small)
    d_txt = is_mon ? "MONDAY ✓" : is_wed ? "WEDNESDAY ✓" : dow == dayofweek.tuesday ? "Tuesday" : dow == dayofweek.thursday ? "Thursday" : dow == dayofweek.friday ? "Friday" : "Weekend"
    table.cell(t, 1, 5, d_txt, text_color=(is_mon or is_wed) ? color.lime : color.white, text_size=size.small)

    // Row 6 — Month Day
    table.cell(t, 0, 6, "Month Day", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 6, "Day " + str.tostring(tdom) + (tdom <= 3 ? " START ✓" : ""),
         text_color=tdom <= 3 ? color.lime : color.white, text_size=size.small)

    // Row 7 — ATR Regime
    table.cell(t, 0, 7, "ATR Regime", text_color=color.gray, text_size=size.small)
    ar_c = atr_rank < 30 ? color.lime : atr_rank > 70 ? color.orange : color.white
    ar_l = atr_rank < 30 ? "LOW ✓ +60%" : atr_rank > 70 ? "HIGH −40%" : "NORMAL"
    table.cell(t, 1, 7, ar_l + " (" + str.tostring(atr_rank, "#") + "p)", text_color=ar_c, text_size=size.small)

    // Row 8 — SMA200
    table.cell(t, 0, 8, "SMA200", text_color=color.gray, text_size=size.small)
    ab = close > sma200 and not na(sma200)
    sd_txt = str.tostring(sma200_dist, "#.#") + "%"
    table.cell(t, 1, 8, (ab ? "ABOVE " : "BELOW ") + sd_txt,
         text_color=ab ? color.lime : color.orange, text_size=size.small)

    // Row 9 — Season / Earnings
    table.cell(t, 0, 9, "Season", text_color=color.gray, text_size=size.small)
    ssn = in_best_months ? "Best ✓" : "Weak"
    earn_txt = in_earnings ? "  ⚠️ EARNINGS" : ""
    table.cell(t, 1, 9, ssn + earn_txt,
         text_color=in_earnings ? color.orange : in_best_months ? color.lime : color.white, text_size=size.small)

    // Row 10 — Separator
    table.cell(t, 0, 10, "─── SIGNALS ───", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 10, "", text_size=size.tiny)

    // Row 11 — E1
    table.cell(t, 0, 11, "E1 MeanRev", text_color=color.gray, text_size=size.small)
    e1_txt = e1 ? ("🟢 LONG " + str.tostring(f_e1, "#.#") + "%" + (vix_sweet ? " ★sweet" : "")) : "⚪ —"
    table.cell(t, 1, 11, e1_txt, text_color=e1 ? color.lime : color.gray, text_size=size.small)

    // Row 12 — E2
    table.cell(t, 0, 12, "E2 Mon/Wed", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 12, e2 ? "🔵 LONG " + str.tostring(f_e2, "#.#") + "%" : "⚪ —",
         text_color=e2 ? color.aqua : color.gray, text_size=size.small)

    // Row 13 — E3
    table.cell(t, 0, 13, "E3 Calm", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 13, e3 ? "🟢 LONG " + str.tostring(f_e3, "#.#") + "%" : "⚪ —",
         text_color=e3 ? color.teal : color.gray, text_size=size.small)

    // Row 14 — E4
    table.cell(t, 0, 14, "E4 GapDown", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 14, e4 ? "🟣 LONG " + str.tostring(f_e4, "#.#") + "% ★PF3.3" : "⚪ —",
         text_color=e4 ? color.purple : color.gray, text_size=size.small)

    // Row 15 — E5
    table.cell(t, 0, 15, "E5 MonStart", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 15, e5 ? "🟡 LONG " + str.tostring(f_e5, "#.#") + "%" : "⚪ —",
         text_color=e5 ? color.yellow : color.gray, text_size=size.small)

    // Row 16 — Separator
    table.cell(t, 0, 16, "", text_size=size.tiny)
    table.cell(t, 1, 16, "", text_size=size.tiny)

    // Row 17 — Conviction
    table.cell(t, 0, 17, "Conviction", text_color=color.white, text_size=size.small)
    conv_txt = edge_count >= 3 ? "★★★ HIGH ×" + str.tostring(conv_mult, "#.#") : edge_count == 2 ? "★★ DOUBLE ×" + str.tostring(conv_mult, "#.#") : edge_count == 1 ? "★ SINGLE" : "— FLAT"
    conv_c = edge_count >= 3 ? color.yellow : edge_count == 2 ? color.lime : edge_count == 1 ? color.aqua : color.gray
    table.cell(t, 1, 17, conv_txt, text_color=conv_c, text_size=size.small)

    // Row 18 — Total Exposure
    table.cell(t, 0, 18, "Exposure", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 18, any_signal ? str.tostring(final_total, "#.#") + "% of equity" : "0%",
         text_color=any_signal ? color.lime : color.gray, text_size=size.small)

    // Row 19 — Position
    table.cell(t, 0, 19, "Position", text_color=color.white, text_size=size.normal)
    p_txt = strategy.position_size > 0 ? "🟢 LONG" : any_signal ? "🟢 BUY NOW" : "⚪ FLAT"
    p_c = strategy.position_size > 0 ? color.lime : any_signal ? color.lime : color.gray
    h_txt = bars_held > 0 ? "  " + str.tostring(bars_held) + "d" : ""
    table.cell(t, 1, 19, p_txt + h_txt, text_color=p_c, text_size=size.normal)

// ─── ALERTS ─────────────────────────────────────────────────────────────────
// Note: alertcondition() requires const string messages — no runtime values.
// Use alert() inside if-blocks for dynamic messages with edge details.

// ── Conviction-based alerts (most important) ──
alertcondition(edge_count >= 3 and strategy.position_size == 0,
     "🔥 3+ EDGES CONVERGE",
     "NASDAQ: ★★★ HIGH CONVICTION — 3+ edges firing! Check chart for details.")

alertcondition(edge_count == 2 and strategy.position_size == 0,
     "⚡ 2 EDGES OVERLAP",
     "NASDAQ: ★★ DOUBLE CONVICTION — 2 edges overlap. Check chart for details.")

// ── Per-edge alerts ──
alertcondition(e1 and strategy.position_size == 0,
     "E1 Mean Reversion",
     "NASDAQ: 🟢 BOUNCE — 3+ down days + VIX<25. Buy at open, sell at close.")

alertcondition(e2 and strategy.position_size == 0,
     "E2 Mon/Wed",
     "NASDAQ: 🔵 Mon/Wed seasonality — VIX<20. Buy at open, sell at close.")

alertcondition(e3 and strategy.position_size == 0,
     "E3 Calm Market",
     "NASDAQ: 🟢 CALM MARKET — VIX<15. Buy at open, sell at close.")

alertcondition(e4 and strategy.position_size == 0,
     "E4 Gap-Down Bounce",
     "NASDAQ: 🟣 GAP BOUNCE — 3+down + gap down >0.3%. PF=3.30! Buy at open.")

alertcondition(e5 and strategy.position_size == 0,
     "E5 Month-Start Flow",
     "NASDAQ: 🟡 MONTH-START — First 3 days of month + VIX<20. Buy at open.")

// ── Catch-all ──
alertcondition(any_signal and strategy.position_size == 0,
     "Any Signal (V3)",
     "NASDAQ: Signal fired — check chart for edge count, conviction & sizing.")

// ── Risk alerts ──
alertcondition(not na(vix_val) and vix_val[1] < 25 and vix_val >= 25,
     "⚠️ VIX DANGER",
     "NASDAQ: VIX crossed above 25 — ALL EDGES SUSPENDED")

alertcondition(not na(vix_val) and vix_val[1] >= 25 and vix_val < 25,
     "✅ VIX Recovery",
     "NASDAQ: VIX dropped below 25 — Edges reactivated")

// ── Dynamic alert() calls — these CAN use series strings ──
// Fires on any new signal with full context (edge list, VIX, sizes)
if any_signal and strategy.position_size == 0
    alert_msg = "NASDAQ V3: " + str.tostring(edge_count) + " edge(s) — "
    alert_msg += e1 ? "MR " : ""
    alert_msg += e2 ? "DOW " : ""
    alert_msg += e3 ? "CALM " : ""
    alert_msg += e4 ? "GAP " : ""
    alert_msg += e5 ? "FLOW " : ""
    alert_msg += "| VIX=" + str.tostring(vix_val, "#.#")
    alert_msg += " | Size=" + str.tostring(final_total, "#.#") + "%"
    alert_msg += edge_count >= 3 ? " ★★★ HIGH CONVICTION" : edge_count == 2 ? " ★★ DOUBLE" : ""
    alert_msg += vix_sweet ? " | VIX SWEET SPOT" : ""
    alert(alert_msg, alert.freq_once_per_bar)

if not na(vix_val) and vix_val[1] < 25 and vix_val >= 25
    alert("⚠️ NASDAQ: VIX crossed above 25 — ALL EDGES SUSPENDED. VIX=" + str.tostring(vix_val, "#.#"), alert.freq_once_per_bar)
