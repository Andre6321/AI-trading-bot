# Bybit AI Trader Environment Configuration
# Copy this file to .env and fill in your values

# ==================== API Configuration ====================
# Get your API keys from:
# Testnet: https://testnet.bybit.com/app/user/api-management
# Mainnet: https://www.bybit.com/app/user/api-management

# For paper trading, using placeholder keys (not real API calls for orders)
BYBIT_API_KEY=paper_trading_test_key
BYBIT_API_SECRET=paper_trading_test_secret

# Use testnet for testing (true) or mainnet for real trading (false)
USE_TESTNET=true

# ==================== Trading Configuration ====================

# Trading pair (BTCUSDT, ETHUSDT, etc.)
TRADING_SYMBOL=BTCUSDT

# Leverage (1-100) - BE CAREFUL with high leverage!
LEVERAGE=2

# Position sizing
# If USE_FIXED_SIZE=true, uses POSITION_SIZE_USD
# If USE_FIXED_SIZE=false, uses POSITION_SIZE_PCT of account balance
USE_FIXED_SIZE=false
POSITION_SIZE_USD=100
POSITION_SIZE_PCT=10

# Risk management
MAX_POSITION_SIZE=1000
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
MAX_DAILY_LOSS_PCT=5.0

# ==================== ML Model Configuration ====================

MODEL_PATH=models/ensemble_btcusdt_h4_enhanced.pkl
MODEL_FEATURES_PATH=models/ensemble_btcusdt_h4_enhanced_metadata.json

# ML strategy parameters
ML_PREDICTION_THRESHOLD=0.45
USE_TREND_FILTER=true
FEATURE_LOOKBACK_HOURS=200

# ==================== Bot Operation ====================

# Paper trading mode (true = no real orders, false = real trading)
PAPER_TRADING=true

# Update intervals (seconds)
CHECK_INTERVAL_SECONDS=300
DATA_REFRESH_MINUTES=60

# Maximum concurrent positions
MAX_OPEN_POSITIONS=1

# ==================== Logging Configuration ====================

LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
LOG_TO_CONSOLE=true

# ==================== Database Configuration ====================

DATABASE_PATH=data/trading_history.db

# ==================== Notifications (Optional) ====================

# Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email notifications
EMAIL_ENABLED=false
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
